# VPS Deployment Template (Optional)
# If you use a custom Linux VPS (e.g. DigitalOcean, Linode, AWS EC2, Hetzner) instead of Vercel/Render,
# rename this file to deploy-vps.yml and add the following secrets in GitHub:
# Settings -> Secrets and variables -> Actions:
# - SERVER_HOST: Your server IP or domain
# - SERVER_USER: Your SSH username (e.g. root or ubuntu)
# - SERVER_SSH_KEY: Your private SSH key
# - SERVER_SSH_PORT: (Optional) SSH port, defaults to 22
# - SERVER_APP_DIR: (Optional) Project folder on server, defaults to ~/Ecommerce-Project

name: Optional VPS SSH Deployment

on:
  workflow_dispatch:

jobs:
  deploy_vps:
    name: Deploy to VPS via SSH
    runs-on: ubuntu-latest
    steps:
      - name: Deploy via SSH
        uses: appleboy/ssh-action@v1.0.3
        with:
          host: ${{ secrets.SERVER_HOST }}
          username: ${{ secrets.SERVER_USER }}
          key: ${{ secrets.SERVER_SSH_KEY }}
          port: ${{ secrets.SERVER_SSH_PORT || 22 }}
          script: |
            set -e
            echo "🚀 Starting Deployment on VPS..."
            cd ${{ secrets.SERVER_APP_DIR || '~/Ecommerce-Project' }}
            git pull origin main
            docker compose -f docker-compose.prod.yml up -d --build
            docker image prune -f
            echo "✅ VPS Deployment completed successfully!"
