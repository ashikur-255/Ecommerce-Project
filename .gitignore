# Root .gitignore
.env
.env.production
.env.local
*.log

# Backend
backend/bin/
backend/obj/
backend/appsettings.Development.json
backend/wwwroot/uploads/*
!backend/wwwroot/uploads/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
frontend/.env
frontend/.env.local
frontend/.env.production

# System & IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

