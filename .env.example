# Server Configuration
DOMAIN_NAME=example.com
CERTBOT_EMAIL=your-email@example.com

# Database (SQL Server 2022)
MSSQL_SA_PASSWORD=YourStrong@Password123!

# JWT Authentication (Minimum 32 characters)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_12345
JWT_ISSUER=EcommerceAPI
JWT_AUDIENCE=EcommerceClient
JWT_EXPIRY_DAYS=7

# Email Settings (Gmail SMTP or SendGrid/Mailgun)
EMAIL_FROM_NAME="Adidas Store"
EMAIL_FROM_EMAIL=your-email@gmail.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password

# SMS Gateway (sms.net.bd)
SMS_API_KEY=your_sms_net_bd_api_key

# Payment: Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Payment: bKash (Sandbox or Production)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password

# Payment: SSLCommerz (Sandbox or Live)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWD=your_store_password
SSLCOMMERZ_IS_SANDBOX=true

# Courier: Steadfast
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=your_steadfast_api_key
STEADFAST_SECRET_KEY=your_steadfast_secret_key
STEADFAST_WEBHOOK_TOKEN=your_random_webhook_token

